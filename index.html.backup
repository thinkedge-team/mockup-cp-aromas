<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <title>
            Vmond Cipta Sejati - Leading Food Manufacturing Company in Indonesia
        </title>

        <!-- SEO Meta Tags -->
        <meta
            name="description"
            content="Vmond Cipta Sejati is a trusted Indonesian food manufacturing company with 15+ years of excellence. Producer of AROMAS cooking oil and quality food products."
        />
        <parameter name="keywords"
            content="vmond cipta sejati, food manufacturing indonesia, aromas cooking oil, food production, indonesian food manufacturer, palm oil producer, manufacturing excellence"
        />
        <meta
            name="author"
            content="Vmond Cipta Sejati"
        />
        <meta
            name="robots"
            content="index, follow"
        />

        <!-- Open Graph / Facebook -->
        <meta
            property="og:type"
            content="website"
        />
        <meta
            property="og:url"
            content="https://vmondciptasejati.com/"
        />
        <meta
            property="og:title"
            content="Vmond Cipta Sejati - Leading Food Manufacturing Company"
        />
        <meta
            property="og:description"
            content="Trusted Indonesian food manufacturing company with 15+ years of excellence in producing quality food products including AROMAS cooking oil."
        />
        <meta
            property="og:image"
            content="https://vmondciptasejati.com/assets/images/LOGO_VMOND_CIPTA_SEJATI.png"
        />
        <meta
            property="og:locale"
            content="id_ID"
        />
        <meta
            property="og:site_name"
            content="Vmond Cipta Sejati"
        />

        <!-- Twitter -->
        <meta
            name="twitter:card"
            content="summary_large_image"
        />
        <meta
            name="twitter:url"
            content="https://vmondciptasejati.com/"
        />
        <meta
            name="twitter:title"
            content="Vmond Cipta Sejati - Food Manufacturing Excellence"
        />
        <meta
            name="twitter:description"
            content="Leading Indonesian food manufacturer producing quality products for over 15 years. Home of AROMAS premium cooking oil."
        />
        <meta
            name="twitter:image"
            content="https://vmondciptasejati.com/assets/images/LOGO_VMOND_CIPTA_SEJATI.png"
        />

        <!-- Theme Color -->
        <meta
            name="theme-color"
            content="#1A365D"
        />
        <meta
            name="msapplication-TileColor"
            content="#1A365D"
        />

        <!-- Bootstrap 5 CSS -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
            rel="stylesheet"
        />

        <!-- Bootstrap Icons -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
            rel="stylesheet"
        />

        <!-- Google Fonts -->
        <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Poppins:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- AOS - Animate On Scroll Library -->
        <link
            href="https://unpkg.com/aos@2.3.1/dist/aos.css"
            rel="stylesheet"
        />

        <!-- Custom CSS -->
        <link
            rel="stylesheet"
            href="css/style.css"
        />
    </head>
    <body>
        <!-- ========== PRELOADER ========== -->
        <div
            id="preloader"
            class="preloader"
        >
            <div class="preloader-inner">
                <div class="preloader-logo">
                    <img src="assets/images/LOGO_VMOND_CIPTA_SEJATI.png" alt="Vmond Cipta Sejati" style="max-width: 200px; max-height: 80px;">
                </div>
                <div class="preloader-spinner">
                    <div class="spinner-ring"></div>
                    <div class="spinner-ring"></div>
                    <div class="spinner-ring"></div>
                </div>
                <p class="preloader-text">Loading...</p>
            </div>
        </div>
        <!-- ========== HEADER / NAVIGATION ========== -->
        <header id="header">
            <nav class="navbar navbar-expand-lg fixed-top">
                <div class="container">
                    <!-- Logo -->
                    <a
                        class="navbar-brand"
                        href="#home"
                    >
                        <img src="assets/images/LOGO_VMOND_CIPTA_SEJATI.png" alt="Vmond Cipta Sejati" class="brand-logo">
                    </a>

                    <!-- Mobile Toggle Button -->
                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation"
                    >
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Navigation Menu -->
                    <div
                        class="collapse navbar-collapse"
                        id="navbarNav"
                    >
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a
                                    class="nav-link active"
                                    href="#home"
                                    >HOME</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#product"
                                    >PRODUCT</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#certificate"
                                    >CERTIFICATE</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#promo"
                                    >PROMO</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#machine"
                                    >OUR MACHINE</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#contact"
                                    >CONTACT US</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#portofolio"
                                    >PORTOFOLIO</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#partnership"
                                    >PARTNERSHIP</a
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- ========== HERO SECTION ========== -->
        <section
            id="home"
            class="hero-section"
        >
            <div class="hero-overlay"></div>

            <!-- Decorative Elements -->
            <div class="hero-decoration">
                <div class="decoration-circle circle-1"></div>
                <div class="decoration-circle circle-2"></div>
                <div class="decoration-circle circle-3"></div>
            </div>

            <div class="container">
                <div class="row align-items-center min-vh-hero">
                    <!-- Left Content -->
                    <div class="col-lg-5 col-md-6 order-lg-1 order-2">
                        <div
                            class="hero-content-left"
                            data-aos="fade-right"
                        >
                            <span class="hero-badge">
                                <i class="bi bi-award-fill"></i> Manufacturing Excellence
                            </span>
                            <h1 class="hero-main-title">
                                <span class="text-gradient">VMOND CIPTA SEJATI</span>
                            </h1>
                            <p class="hero-description">
                                Building Indonesia's Manufacturing Future. A trusted food manufacturing company with over 15 years of excellence in producing quality products for Indonesian families and businesses nationwide.
                            </p>

                            <!-- Feature Pills -->
                            <div class="hero-pills">
                                <span class="pill"
                                    ><i class="bi bi-check-circle-fill"></i>
                                    ISO Certified</span
                                >
                                <span class="pill"
                                    ><i class="bi bi-check-circle-fill"></i>
                                    Halal MUI</span
                                >
                                <span class="pill"
                                    ><i class="bi bi-check-circle-fill"></i>
                                    BPOM Certified</span
                                >
                            </div>

                            <!-- CTA Buttons -->
                            <div class="hero-actions">
                                <a
                                    href="#product"
                                    class="btn-primary-hero"
                                >
                                    <i class="bi bi-box-seam-fill"></i>
                                    <span>Our Products</span>
                                </a>
                                <a
                                    href="#partnership"
                                    class="btn-secondary-hero"
                                >
                                    <i class="bi bi-handshake-fill"></i>
                                    <span>Partner With Us</span>
                                </a>
                            </div>

                            <!-- Trust Badges -->
                            <div class="hero-trust">
                                <div class="trust-item">
                                    <strong>15+</strong>
                                    <span>Years Experience</span>
                                </div>
                                <div class="trust-divider"></div>
                                <div class="trust-item">
                                    <strong>1M+</strong>
                                    <span>Customers Served</span>
                                </div>
                                <div class="trust-divider"></div>
                                <div class="trust-item">
                                    <strong>500+</strong>
                                    <span>Distribution Partners</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Center/Right Company Visual -->
                    <div class="col-lg-7 col-md-6 order-lg-2 order-1">
                        <div
                            class="hero-product-wrapper"
                            data-aos="fade-left"
                            data-aos-delay="200"
                        >
                            <!-- Product Glow Effect -->
                            <div class="product-glow-ring"></div>

                            <!-- Main Company Logo -->
                            <img
                                src="assets/images/LOGO_VMOND_CIPTA_SEJATI.png"
                                alt="Vmond Cipta Sejati"
                                class="hero-product-img"
                                style="max-width: 80%; filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.5)) brightness(1.1);"
                            />

                            <!-- Floating Feature Cards -->
                            <div
                                class="floating-card card-1"
                                data-aos="fade-down"
                                data-aos-delay="400"
                            >
                                <div class="floating-icon">
                                    <i class="bi bi-gear-fill"></i>
                                </div>
                                <div class="floating-text">
                                    <strong>Advanced</strong>
                                    <span>Technology</span>
                                </div>
                            </div>

                            <div
                                class="floating-card card-2"
                                data-aos="fade-up"
                                data-aos-delay="500"
                            >
                                <div class="floating-icon">
                                    <i class="bi bi-shield-check-fill"></i>
                                </div>
                                <div class="floating-text">
                                    <strong>Quality</strong>
                                    <span>Guaranteed</span>
                                </div>
                            </div>

                            <div
                                class="floating-card card-3"
                                data-aos="fade-left"
                                data-aos-delay="600"
                            >
                                <div class="floating-icon">
                                    <i class="bi bi-globe-asia-australia"></i>
                                </div>
                                <div class="floating-text">
                                    <strong>Nationwide</strong>
                                    <span>Distribution</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="scroll-indicator">
                <div class="mouse">
                    <div class="wheel"></div>
                </div>
                <span>Scroll Down</span>
            </div>
        </section>





        <!-- ========== CERTIFICATE SECTION ========== -->
        <section
            id="certificate"
            class="certificate-section py-5 bg-light"
        >
            <div class="container">
                <div class="text-center mb-5" data-aos="fade-up">
                    <h2 class="section-title">
                        CERTIFICATIONS & COMPLIANCE
                    </h2>
                    <p class="section-subtitle">
                        Vmond Cipta Sejati maintains the highest standards in food safety and quality management, 
                        certified by national and international regulatory bodies.
                    </p>
                </div>

                <div class="row g-4 justify-content-center">
                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="certificate-card">
                            <div class="certificate-icon">
                                <i class="bi bi-shield-fill-check"></i>
                            </div>
                            <h4>BPOM RI</h4>
                            <p class="certificate-number">MD 123456789</p>
                            <p class="certificate-desc">
                                Registered with Indonesian Food and Drug Monitoring Agency, ensuring product safety and quality standards.
                            </p>
                            <span class="certificate-badge valid">
                                <i class="bi bi-check-circle-fill"></i> Valid
                            </span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="certificate-card">
                            <div class="certificate-icon text-success">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                            <h4>HALAL MUI</h4>
                            <p class="certificate-number">ID12345678910111</p>
                            <p class="certificate-desc">
                                Certified Halal by Majelis Ulama Indonesia, guaranteeing compliance with Islamic dietary laws.
                            </p>
                            <span class="certificate-badge valid">
                                <i class="bi bi-check-circle-fill"></i> Valid
                            </span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="certificate-card">
                            <div class="certificate-icon text-primary">
                                <i class="bi bi-award-fill"></i>
                            </div>
                            <h4>ISO 22000:2018</h4>
                            <p class="certificate-number">FSMS-2023-001</p>
                            <p class="certificate-desc">
                                International Food Safety Management System certification, ensuring comprehensive quality control.
                            </p>
                            <span class="certificate-badge valid">
                                <i class="bi bi-check-circle-fill"></i> Valid
                            </span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="certificate-card">
                            <div class="certificate-icon text-warning">
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <h4>GMP</h4>
                            <p class="certificate-number">GMP-ID-2023</p>
                            <p class="certificate-desc">
                                Good Manufacturing Practice certification, maintaining hygiene and production standards.
                            </p>
                            <span class="certificate-badge valid">
                                <i class="bi bi-check-circle-fill"></i> Valid
                            </span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-5" data-aos="fade-up">
                    <a href="#contact" class="btn btn-primary btn-lg">
                        Request Certificate Documents
                    </a>
                </div>
            </div>
        </section>

        <!-- ========== PRODUCT SECTION ========== -->
        <section
            id="product"
            class="product-section py-5"
        >
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6" data-aos="fade-right">
                        <div class="product-image-wrapper">
                            <img
                                src="assets/images/aromas-product.png"
                                alt="AROMAS Cooking Oil"
                                class="img-fluid product-img"
                            />
                        </div>
                    </div>
                    <div class="col-lg-6" data-aos="fade-left">
                        <div class="product-content">
                            <span class="product-badge">FLAGSHIP PRODUCT</span>
                            <h2 class="product-title">
                                AROMAS<br />
                                <span class="product-subtitle">Premium Cooking Oil</span>
                            </h2>
                            <p class="product-description">
                                AROMAS is our flagship premium cooking oil brand, produced with advanced technology 
                                and strict quality control to deliver the best cooking experience for Indonesian families. 
                                Made from selected palm oil with international food safety standards.
                            </p>
                            
                            <div class="product-features">
                                <div class="feature-item">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>Low cholesterol & heart-healthy</span>
                                </div>
                                <div class="feature-item">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>Crystal clear & odorless</span>
                                </div>
                                <div class="feature-item">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>High smoke point for repeated frying</span>
                                </div>
                                <div class="feature-item">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>Enriched with natural Vitamin E</span>
                                </div>
                            </div>

                            <div class="product-variants mt-4">
                                <h5>Available Sizes:</h5>
                                <div class="variants-list">
                                    <span class="variant-badge">250ml</span>
                                    <span class="variant-badge">500ml</span>
                                    <span class="variant-badge">1L</span>
                                    <span class="variant-badge">2L</span>
                                    <span class="variant-badge">5L</span>
                                    <span class="variant-badge">18L (Bulk)</span>
                                </div>
                            </div>

                            <div class="product-cta mt-4">
                                <a href="#contact" class="btn btn-primary btn-lg">Request Quote</a>
                                <a href="#certificate" class="btn btn-outline-primary btn-lg ms-2">View Certificates</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== PROMO SECTION ========== -->
        <section
            id="promo"
            class="promo-section py-5"
            style="background: linear-gradient(135deg, var(--primary-navy) 0%, var(--primary-navy-dark) 100%);"
        >
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6" data-aos="fade-right">
                        <div class="promo-content text-white">
                            <span class="promo-badge">SPECIAL OFFER</span>
                            <h2 class="display-4 fw-bold mb-4">
                                B2B Partnership Opportunities
                            </h2>
                            <p class="lead mb-4">
                                Join our growing network of business partners and enjoy exclusive benefits 
                                for bulk orders, competitive pricing, and guaranteed supply chain.
                            </p>
                            
                            <div class="promo-benefits">
                                <div class="benefit-row">
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                    <span>Competitive wholesale pricing for bulk orders</span>
                                </div>
                                <div class="benefit-row">
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                    <span>Flexible payment terms & credit facilities</span>
                                </div>
                                <div class="benefit-row">
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                    <span>Dedicated account manager support</span>
                                </div>
                                <div class="benefit-row">
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                    <span>Priority delivery & logistics support</span>
                                </div>
                                <div class="benefit-row">
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                    <span>Marketing & promotional support</span>
                                </div>
                            </div>

                            <div class="mt-5">
                                <a href="#contact" class="btn btn-warning btn-lg me-3">
                                    <i class="bi bi-envelope-fill me-2"></i>Contact for Details
                                </a>
                                <a href="#partnership" class="btn btn-outline-light btn-lg">
                                    Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6" data-aos="fade-left">
                        <div class="promo-features">
                            <div class="feature-box">
                                <div class="feature-icon">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <h4>Nationwide Distribution</h4>
                                <p>Reliable delivery across all provinces in Indonesia</p>
                            </div>
                            <div class="feature-box">
                                <div class="feature-icon">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <h4>Bulk Order Discounts</h4>
                                <p>Save up to 20% on large volume orders</p>
                            </div>
                            <div class="feature-box">
                                <div class="feature-icon">
                                    <i class="bi bi-calendar-check"></i>
                                </div>
                                <h4>Flexible Terms</h4>
                                <p>30-60 day payment terms for qualified partners</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== OUR MACHINE SECTION ========== -->
        <section
            id="our-machine"
            class="machine-section py-5 bg-light"
        >
            <div class="container">
                <div class="text-center mb-5" data-aos="fade-up">
                    <h2 class="section-title">OUR PRODUCTION MACHINES</h2>
                    <p class="section-subtitle">
                        State-of-the-art machinery and technology for premium quality production
                    </p>
                </div>

                <!-- Main Carousel -->
                <div id="machineCarousel" class="carousel slide" data-bs-ride="carousel" data-aos="fade-up">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Machine 1"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="1" aria-label="Machine 2"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="2" aria-label="Machine 3"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="3" aria-label="Machine 4"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="4" aria-label="Machine 5"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="5" aria-label="Machine 6"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="6" aria-label="Machine 7"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="7" aria-label="Machine 8"></button>
                        <button type="button" data-bs-target="#machineCarousel" data-bs-slide-to="8" aria-label="Machine 9"></button>
                    </div>
                    
                    <div class="carousel-inner rounded-3 shadow-lg">
                        <div class="carousel-item active">
                            <img src="assets/images/machine-1.jpeg" class="d-block w-100" alt="Production Machine 1" style="height: 500px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3">
                                <h5>Advanced Refining System</h5>
                                <p>High-capacity oil refining equipment for premium quality output</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="assets/images/machine-2.jpeg" class="d-block w-100" alt="Production Machine 2" style="height: 500px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3">
                                <h5>Automated Filtration Unit</h5>
                                <p>State-of-the-art filtration technology for crystal clear oil</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="assets/images/machine-3.jpeg" class="d-block w-100" alt="Production Machine 3" style="height: 500px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3">
                                <h5>Quality Control Laboratory</h5>
                                <p>Advanced testing equipment ensuring product standards</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="assets/images/machine-4.jpeg" class="d-block w-100" alt="Production Machine 4" style="height: 500px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3">
                                <h5>Automated Bottling Line</h5>
                                <p>High-speed bottling system with precision filling</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="assets/images/machine-5.jpeg" class="d-block w-100" alt="Production Machine 5" style="height: 500px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3">
                                <h5>Packaging Automation</h5>
                                <p>Efficient packaging system for various product sizes</p>
                            </div>
                        </div>
